# Environment for the stockroom service.
# Install to /etc/stockroom.env and edit. Read by deploy/stockroom.service.
#
# Everything here is optional -- the defaults work for a standard install.
#
# QUOTE EVERY VALUE. This file is read by two different parsers that do not
# agree: systemd's EnvironmentFile= takes everything after the first `=` as a
# literal value, so `STOCKROOM_ORG=Carlson Center for Imaging Science` is
# valid there -- but the same line makes bash try to run `Center` as a
# command. Double quotes are correct for both; systemd strips them.
# deploy/setup-pi.sh no longer sources this file for exactly that reason, and
# tests/test_deploy.py fails if a value here is left unquoted.

# Where the database and backups live.
STOCKROOM_DATA_DIR="/var/lib/stockroom"

# Where the generated public page is written. The service serves this at
# /public; point nginx here as well if you want it on port 80.
STOCKROOM_PUBLISH_DIR="/var/lib/stockroom/publish"

# Heading shown on the public page.
STOCKROOM_ORG="Carlson Center for Imaging Science — RIT"

# Host names this service answers to. Comma separated. Leave it unset and it
# defaults to this machine's own hostname -- qualified (from `hostname -f`) and
# short -- that short name with `.local`, and loopback. That covers a Pi with a
# DNS record without any help, so set this only for a name the machine does not
# know it has: a second alias, or a CNAME pointing at it.
#
# A request whose Host is not on the list gets a 400 naming this variable.
# Bare IP addresses are always accepted, so browsing to the Pi's address works
# on devices that cannot resolve `.local`; STOCKROOM_ALLOW_IP_HOSTS="0" turns
# that off.
#
# A leading `*.` wildcard matches one or more subdomain labels.
# STOCKROOM_ALLOWED_HOSTS="cisstockroom,cisstockroom.device.rit.edu,*.cis.rit.edu"
# STOCKROOM_ALLOW_IP_HOSTS="1"

# Publish borrower names and emails on the PUBLIC page. Off by default and
# should stay off: the public page is meant to answer "is one free?", not
# "who has it?". Staff can always see borrowers in the internal UI.
# STOCKROOM_PUBLIC_SHOW_BORROWERS="0"

# --- Optional: mirror the public page to GitHub Pages --------------------
# Point this at a local clone of the Pages repo that can already push
# (deploy key in ~/.ssh, or a token in the remote URL). Leave unset to
# publish only to the Pi.
# STOCKROOM_GITHUB_PAGES_DIR="/var/lib/stockroom/pages"
# STOCKROOM_GITHUB_PAGES_BRANCH="main"

# Barcode prefix for generated codes (CIS-000142).
# STOCKROOM_BARCODE_PREFIX="CIS"

# Seconds to coalesce rapid changes into one page rebuild.
# STOCKROOM_PUBLISH_DEBOUNCE="2.0"

# Nightly database snapshots to keep.
# STOCKROOM_BACKUP_KEEP="30"

# --- Getting backups off the SD card -------------------------------------
# Snapshots default to living on the same card as the database they protect,
# which means one card failure loses both. Set either or both of these.
#
# A second local directory -- a USB stick left plugged into the Pi.
# STOCKROOM_BACKUP_COPY_DIR="/mnt/stockroom-usb"

# An rclone remote, for Google Drive or anything else rclone speaks. Set it
# up once as the service user, which is where the app expects the config:
#
#     sudo apt install rclone
#     sudo -u stockroom rclone config       # creates the remote, does OAuth
#     sudo -u stockroom /opt/stockroom/.venv/bin/stockroom backup
#
# The uploaded file is a readable copy of the entire database -- every email
# address and the whole audit log. Keep that Drive folder private to the
# account that owns it, and do not share the link.
# STOCKROOM_BACKUP_REMOTE="gdrive:stockroom-backups"
# STOCKROOM_BACKUP_REMOTE_KEEP="30"
# STOCKROOM_RCLONE="/usr/bin/rclone"

# How many days a pending request or signup may sit before the inbox flags it
# as stale. Nothing emails anyone, so this is the only nudge there is.
# STOCKROOM_REQUEST_STALE_DAYS="3"

# --- RIT single sign-on ----------------------------------------------------
#
# Off by default, and it must stay off until RIT ITS have registered this
# service provider -- see docs/its-registration.md, which is the ticket.
#
# Three modes:
#   password  what has always happened. Stockroom passwords, nothing else.
#   both      the RIT button and the password form together. What a migration
#             term looks like: everyone moves across, nobody is locked out.
#   sso       RIT only. /login forwards to the identity provider.
#
# If single sign-on ever breaks -- an expired certificate, an IdP outage, a
# metadata rotation nobody caught -- set this back to "password" and
# `systemctl restart stockroom`. Everyone who had a password is back in
# immediately. That is the escape hatch; it is the reason the password
# machinery is still here.
# STOCKROOM_AUTH_MODE="password"

# The origin RIT knows this server by. Every SAML URL is derived from it and
# none is ever taken from the Host header. Must be https:// -- the sign-in
# handshake needs a SameSite=None cookie, which browsers refuse without it.
# STOCKROOM_SSO_BASE_URL="https://cisstockroom.device.rit.edu"

# The entityID ITS have on file. Defaults to <base URL>/shibboleth, which is
# the convention RIT's own documentation uses. It must match what ITS
# configured, exactly, or every assertion is refused as the wrong audience.
# STOCKROOM_SSO_ENTITY_ID="https://cisstockroom.device.rit.edu/shibboleth"

# Made by `stockroom sso init`. The keypair signs SAML and is published in our
# metadata; it is NOT the TLS certificate and no certificate authority is
# involved -- ITS pin it at registration. It expires after three years, and
# replacing it means telling ITS.
# STOCKROOM_SSO_SP_CERT="/etc/stockroom/sp.crt"
# STOCKROOM_SSO_SP_KEY="/etc/stockroom/sp.key"

# RIT's own metadata, cached on disk. Never fetched during a sign-in: the Pi
# may be off the network, and a login that hangs on someone else's server is
# worse than one that refuses. RIT rotate their signing certificate, and a
# stale copy fails every sign-in with a signature error -- `stockroom doctor`
# warns once the cache is six months old.
#
#     stockroom sso init --refresh
#
# STOCKROOM_SSO_IDP_METADATA="/etc/stockroom/rit-metadata.xml"

# Whether a first-time RIT sign-in can use the stockroom straight away. The
# identity provider has proved who they are and `requester` can only ask to
# borrow things, so the default is yes. Set "0" to keep staff approval as a
# gate on access rather than on identity.
# STOCKROOM_SSO_AUTO_APPROVE="1"

# Ask ITS whether they require these; both default off.
# STOCKROOM_SSO_SIGN_REQUESTS="0"
# STOCKROOM_SSO_ENCRYPTED_ASSERTIONS="0"

# How long a started sign-in stays valid, in seconds.
# STOCKROOM_SSO_HANDSHAKE_TTL="300"
