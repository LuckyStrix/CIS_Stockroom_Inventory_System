[Unit]
Description=CIS Stockroom Inventory System
Documentation=file:/opt/stockroom/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=stockroom
Group=stockroom
WorkingDirectory=/opt/stockroom
EnvironmentFile=/etc/stockroom.env

# Bound to loopback ONLY. nginx is the single thing that can reach the app,
# which is what makes it safe for the app to trust X-Forwarded-Proto and
# X-Forwarded-For -- no client can set those headers directly.
# --proxy-headers is what tells uvicorn to read them.
ExecStart=/opt/stockroom/.venv/bin/uvicorn stockroom.web.app:app \
    --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

# One worker on purpose. SQLite handles concurrent readers well but a single
# writer; one process keeps the publish debounce and the write path simple,
# and a stockroom's load is a handful of requests a minute.

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# The service only ever needs to write its own data directory. Everything
# below is defence in depth: if the application is ever compromised, this is
# what stops it becoming a foothold on the rest of the machine.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Only local and IP sockets; no raw packets, no exotic families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
ReadWritePaths=/var/lib/stockroom
StateDirectory=stockroom

# The database holds every password hash, every session token hash and every
# email address in the stockroom. Without these two lines systemd creates the
# state directory 0755 and Python creates stockroom.db 0644, so any local
# account on the Pi can read the lot -- security.py reasons carefully about
# someone stealing the SD card and not at all about someone with a shell.
#
# 0751 on the directory and 0027 on new files keeps its contents to the service
# user and its group: others get the traverse bit (--x) and nothing else, so
# they can walk through to a path they already know and cannot list what is
# here or open the database. The publish directory is 0755 and the files in it
# are chmod'ed 0644 by publish/publishers.py -- nginx serves those, and only
# those.
#
# It must be 0751 and not 0750, and it must match `chmod 0751 "$DATA_DIR"` in
# setup-pi.sh: systemd re-applies this mode on EVERY start, so a stricter value
# here silently undoes the installer the first time the service restarts. That
# is what it did. Without the traverse bit nginx cannot reach publish/index.html
# however open publish/ itself is, and `try_files` reports a permission denial
# as a miss -- so the public page answered 404 with the file sitting right
# there, while every proxied staff page carried on working.
StateDirectoryMode=0751
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stockroom

[Install]
WantedBy=multi-user.target
