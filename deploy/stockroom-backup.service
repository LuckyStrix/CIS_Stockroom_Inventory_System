[Unit]
Description=Snapshot the stockroom database
Documentation=file:/opt/stockroom/docs/operations.md

[Service]
Type=oneshot
User=stockroom
Group=stockroom
WorkingDirectory=/opt/stockroom
EnvironmentFile=/etc/stockroom.env

# WHY THE FIRST TWO LINES START WITH "-"
#
# Type=oneshot runs these in order and stops at the first one that fails. That
# made `doctor` -- the only thing on this machine that ever checks the audit
# chain, the database integrity or the age of the backups -- conditional on
# everything before it succeeding. A USB stick nobody plugged back in made
# `stockroom backup` exit non-zero, and the nightly health check silently
# stopped running on exactly the night it mattered most.
#
# The "-" makes systemd carry on past a failure. Nothing is lost by it: an
# off-box copy that did not happen is reported by doctor's own
# check_offsite_backups, so the unit still ends up failed and `systemctl
# status` still shows why. What changes is that the diagnosis runs.

# Uses SQLite's online backup API, so this is safe to run while the web
# service is live. Old snapshots are pruned to STOCKROOM_BACKUP_KEEP.
ExecStart=-/opt/stockroom/.venv/bin/stockroom backup
# Housekeeping in the same nightly job: expired sessions and old login
# attempts accumulate otherwise, and neither is worth keeping forever.
ExecStart=-/opt/stockroom/.venv/bin/stockroom prune
# And check the result is actually healthy. This is the only thing that
# routinely looks at the machine, so a failure here is how a dead backup
# timer, a corrupt database or a broken audit chain gets noticed at all.
# Deliberately last and deliberately NOT "-": its exit code is what marks the
# unit failed, which `systemctl status` then shows.
ExecStart=/opt/stockroom/.venv/bin/stockroom doctor

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

# ProtectSystem=strict makes the entire filesystem read-only except what is
# listed here. STOCKROOM_BACKUP_COPY_DIR usually points somewhere else --
# /mnt/stockroom-usb, say -- and writing there fails with a read-only-filesystem
# error under systemd while working perfectly when the same command is run by
# hand, which is the worst possible combination to debug.
#
# setup-pi.sh reads that variable out of /etc/stockroom.env and writes the
# matching path into a drop-in at
#
#     /etc/systemd/system/stockroom-backup.service.d/backup-copy-dir.conf
#
# so it is granted automatically. Set the variable and re-run the installer;
# do not edit this file.
ReadWritePaths=/var/lib/stockroom
